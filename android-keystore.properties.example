# Release signing credentials for Play Store uploads.
#
# COPY THIS FILE to android/keystore.properties after running `expo prebuild`.
# That path is gitignored — the keystore and its passwords must never be committed.
#
# 1. Generate an upload keystore (once, and keep the backup somewhere safe):
#
#      keytool -genkeypair -v \
#        -keystore upload-keystore.jks \
#        -alias apphub-upload \
#        -keyalg RSA -keysize 2048 -validity 10000
#
#    Put upload-keystore.jks somewhere OUTSIDE this repo, then point storeFile at it.
#
# 2. Copy this file to android/keystore.properties and fill in the four values.
#
# 3. Build:  cd android && ./gradlew bundleRelease
#
# storeFile is resolved relative to the `android/` directory, so an absolute path or a
# path such as ../../keys/upload-keystore.jks both work.
#
# If you enrol in Play App Signing (recommended), this key is only the UPLOAD key:
# losing it is recoverable through Play support. Without Play App Signing, losing it
# means you can never publish an update to this package name again.

storeFile=../../keys/upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=apphub-upload
keyPassword=CHANGE_ME
