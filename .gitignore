dist/

# Only ignore generated native folders at the repository root.
# Hand-written native sources under modules/*/android and modules/*/ios
# must remain tracked.
/android/
/ios/

*.log

# Signing material. /android/ already covers android/keystore.properties, but these
# patterns also catch a keystore left anywhere else in the tree by accident.
*.jks
*.keystore
keystore.properties
