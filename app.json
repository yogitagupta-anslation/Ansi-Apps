{
  "expo": {
    "name": "App Hub",
    "slug": "app-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "apphub",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#070A12",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yg.apphub",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "App Hub uses Bluetooth for offline chat and to show which other attendees are near you. It never uses your location.",
        "NSBluetoothPeripheralUsageDescription": "App Hub broadcasts a temporary identifier so nearby devices running the same app can find you.",
        "NSMotionUsageDescription": "EventPulse uses the compass and motion sensors to keep the event map oriented as you turn.",
        "NSPhotoLibraryUsageDescription": "EventPulse needs access to your photos so you can choose a profile picture. The image is cropped and resized on your device.",
        "UIBackgroundModes": [
          "bluetooth-central",
          "bluetooth-peripheral"
        ]
      }
    },
    "android": {
      "package": "com.yg.apphub",
      "adaptiveIcon": {
        "backgroundColor": "#070A12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-audio",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "EventPulse needs access to your photos so you can choose a profile picture. The image is cropped and resized on your device."
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "neverForLocation": false,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "App Hub uses Bluetooth to chat with and discover nearby devices."
        }
      ],
      "@react-native-vector-icons/lucide",
      "./plugins/withEventPulseBle.js",
      "./plugins/withBleChatNative.js",
      "./plugins/withAttendanceNative.js",
      "./plugins/withReleaseHardening.js",
      "expo-font"
    ]
  }
}
